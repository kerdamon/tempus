{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": ["python@latest", "uv@latest"],
  "shell": {
    "init_hook": [
      "uv sync",
      ". $VENV_DIR/bin/activate",
      "echo 'Devbox environment activated'"
    ],
    "scripts": {
      "dev": "uv run fastapi dev"
    }
  }
}
